# Public Google OAuth client IDs (not secrets).
# Create Web, Android, and iOS OAuth clients in the same Google Cloud project.
# Production builds: set to https://api.golivehostel360.com only when releasing.
# Local development should use the local/staging API, not production data.
# EXPO_PUBLIC_BACKEND_URL=https://api.golivehostel360.com
EXPO_PUBLIC_GOOGLE_DIRECT_SIGNIN_ENABLED=false
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# The iOS OAuth client's reversed client ID, used as its URL scheme by the Expo plugin.
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=
