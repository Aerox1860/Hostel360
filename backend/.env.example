# ==============================================
# HOSTEL 360 ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in your values
# =============================================

# MONGODB
# Connection URL for MongoDB Atlas or local instance
MONGO_URL=mongodb+srv://username:password@cluster.mongodb.net/
DB_NAME=hostel360

# JWT & AUTHENTICATION
# Keep JWT_SECRET secure and unique per environment
JWT_SECRET=your-super-secret-jwt-key-change-this
ADMIN_EMAIL=admin@hostel360.com
ADMIN_PASSWORD=Admin@12345

# STRIPE PAYMENT GATEWAY (Optional - USD payments)
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_API_KEY=sk_test_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx

# RAZORPAY PAYMENT GATEWAY (Required - INR payments)
# Get from: https://dashboard.razorpay.com/settings/api-keys
RAZORPAY_KEY_ID=rzp_test_TY5iBO5vYMtVyt
RAZORPAY_KEY_SECRET=Y8r9260ZlRKTwIdYdYt5gzyc

# Razorpay Webhook Secret (from Settings > Webhooks)
# Get from: https://dashboard.razorpay.com/settings/webhooks
RAZORPAY_WEBHOOK_SECRET=whsec_xxxx_xxxxxxxx

# BACKEND CONFIGURATION
# Full URL where backend is deployed (for payment callbacks)
EXPO_PUBLIC_BACKEND_URL=http://localhost:8000

# Trial period duration in days
TRIAL_DAYS=45

# ==============================================
# ENVIRONMENT-SPECIFIC NOTES
# ==============================================

# DEVELOPMENT
# - Use rzp_test_* keys for Razorpay
# - Use sk_test_* keys for Stripe
# - EXPO_PUBLIC_BACKEND_URL=http://localhost:8000

# PRODUCTION
# - Use rzp_live_* keys for Razorpay
# - Use sk_live_* keys for Stripe
# - EXPO_PUBLIC_BACKEND_URL=https://your-domain.com
# - Ensure RAZORPAY_WEBHOOK_SECRET matches Razorpay Dashboard

# ==============================================
# HOW TO GET CREDENTIALS
# ==============================================

# 1. MongoDB
#    - Go to MongoDB Atlas: https://www.mongodb.com/cloud/atlas
#    - Create cluster → Create database → Connection string
#    - Format: mongodb+srv://user:pass@cluster.mongodb.net/

# 2. Razorpay (INR Payments)
#    - Go to: https://dashboard.razorpay.com
#    - Settings → API Keys → Copy Key ID and Key Secret
#    - Settings → Webhooks → Create & copy Webhook Secret
#    - Event: payment_link.paid
#    - Webhook URL: https://your-domain.com/api/razorpay/webhook

# 3. Stripe (USD Payments)
#    - Go to: https://dashboard.stripe.com/apikeys
#    - Copy Publishable Key (not needed in .env) and Secret Key
#    - Webhooks section → Create endpoint → Copy signing secret

# 4. JWT Secret
#    - Generate secure random string: 
#    - python: import secrets; secrets.token_urlsafe(32)
#    - node: require('crypto').randomBytes(32).toString('hex')
