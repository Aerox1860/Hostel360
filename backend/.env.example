# ==============================================
# HOSTEL 360 ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in your values
# =============================================

# Runtime mode. Production startup rejects placeholder secrets and wildcard/non-HTTPS CORS origins.
APP_ENV=development
CORS_ALLOWED_ORIGINS=*

# MONGODB
# Connection URL for MongoDB Atlas or local instance
MONGO_URL=
DB_NAME=hostel360

# JWT & AUTHENTICATION
# Keep JWT_SECRET secure and unique per environment
JWT_SECRET=replace-with-a-unique-secret-of-at-least-32-bytes
# Generate a separate stable secret with at least 32 random bytes for keyed Aadhaar duplicate detection.
# Keep this stable across all backend instances. Because raw Aadhaar values are not retained,
# replacing this key requires re-verifying the affected tenant identities.
TENANT_AADHAAR_HMAC_KEY=replace-with-a-stable-secret-of-at-least-32-bytes
# Keep the existing Fernet key unchanged to decrypt previously stored tenant files and evidence.
TENANT_DOCUMENT_ENCRYPTION_KEY=replace-with-the-existing-valid-fernet-key
ADMIN_EMAIL=admin@hostel360.com
ADMIN_PASSWORD=replace-with-a-strong-password

# DIRECT GOOGLE SIGN-IN
# Comma-separated OAuth client IDs accepted as Google ID-token audiences.
# Include the Web, Android, and iOS client IDs for accepted audience/authorized-party claims.
# These are public client IDs; do not put client secrets here or in the frontend.
GOOGLE_OAUTH_CLIENT_IDS=

# RULES IMAGE OCR (optional; keep this server-side only)
# Uses the existing httpx backend dependency. Images are sent to Google
# Gemini for verbatim OCR; configure billing/quotas in Google AI Studio.
# Review Google's current pricing and data-retention terms before enabling.
GOOGLE_GENAI_API_KEY=
RULES_OCR_MODEL=gemini-2.5-flash

# STRIPE PAYMENT GATEWAY (Optional - USD payments)
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# RAZORPAY PAYMENT GATEWAY (Required - INR payments)
# Get from: https://dashboard.razorpay.com/settings/api-keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Razorpay Webhook Secret (from Settings > Webhooks)
# Get from: https://dashboard.razorpay.com/settings/webhooks
RAZORPAY_WEBHOOK_SECRET=

# BACKEND CONFIGURATION
# Full URL where backend is deployed (for payment callbacks)

# Trial period duration in days
TRIAL_DAYS=45

# ==============================================
# ENVIRONMENT-SPECIFIC NOTES
# ==============================================

# DEVELOPMENT
# EXPO_PUBLIC_BACKEND_URL=https://api.golivehostel360.com

# - Use rzp_test_* keys for Razorpay
# - Use sk_test_* keys for Stripe
# PRODUCTION
# EXPO_PUBLIC_BACKEND_URL=https://api.golivehostel360.com
# - Use rzp_live_* keys for Razorpay
# - Use sk_live_* keys for Stripe
# Ensure RAZORPAY_WEBHOOK_SECRET matches Razorpay Dashboard

# ==============================================
# HOW TO GET CREDENTIALS
# ==============================================

# 1. MongoDB
#    - Go to MongoDB Atlas: https://www.mongodb.com/cloud/atlas
#    - Create cluster → Create database → Connection string
#    - Format: mongodb+srv://user:pass@cluster.mongodb.net/

# 2. Razorpay (INR Payments)
#    - Go to: https://dashboard.razorpay.com
#    - Settings → API Keys → Copy Key ID and Key Secret
#    - Settings → Webhooks → Create & copy Webhook Secret
#    - Event: payment_link.paid
#    - Webhook URL: https://api.golivehostel360.com/api/razorpay/webhook
# 3. Stripe (USD Payments)
#    - Go to: https://dashboard.stripe.com/apikeys
#    - Copy Publishable Key (not needed in .env) and Secret Key
#    - Webhooks section → Create endpoint → Copy signing secret

# 4. JWT Secret
#    - Generate secure random string: 
#    - python: import secrets; secrets.token_urlsafe(32)
#    - node: require('crypto').randomBytes(32).toString('hex')
