# Local development uses the local FastAPI backend. Set the production API origin
# only in the production web build environment, after deployment approval.
VITE_API_ORIGIN=http://localhost:8000

# Direct Google Identity Services is disabled until a Web OAuth client ID and
# authorized browser origin are configured. The backend must also accept the ID.
VITE_GOOGLE_DIRECT_SIGNIN_ENABLED=false
VITE_GOOGLE_WEB_CLIENT_ID=
